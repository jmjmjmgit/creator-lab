# Copy with npm run setup. Keep real keys in .env only.
# Choose fireworks OR groq, then fill that provider's key.
TRANSCRIPTION_PROVIDER=fireworks
APIFY_TOKEN=
FIREWORKS_API_KEY=
GROQ_API_KEY=

# Classifier: jev (TypeSafe) OR llm (any OpenAI-compatible API, such as hcnsec).
CLASSIFIER=jev
TYPESAFE_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.hcnsec.cn/v1
LLM_MODEL=
# Optional, in US dollars per million tokens, for the dashboard cost estimate.
LLM_INPUT_USD_PER_M=
LLM_OUTPUT_USD_PER_M=

PORT=5190

# Local pacing ceilings. Lower these to fit your actual account limits.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20
